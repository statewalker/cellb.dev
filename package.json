{
  "name": "@statewalker/cellb-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "description": "cellb: an isomorphic Durable Objects runtime (celld/Cloudflare-compatible) for browsers and servers.",
  "homepage": "https://github.com/statewalker/cellb.dev#readme",
  "bugs": {
    "url": "https://github.com/statewalker/cellb.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git"
  },
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"!./packages/platform\" run build",
    "test": "pnpm -r run test",
    "test:nightly": "bash .github/scripts/nightly.sh",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:tests": "tsc -p examples/agents && tsc -p examples/fake-openai && tsc -p examples/flue && tsc -p examples/emdash/tsconfig.test.json && tsc -p examples/astro-in-browser/tsconfig.test.json && tsc -p examples/tesseract-ocr/tsconfig.test.json",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
