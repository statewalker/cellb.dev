{
  "name": "@statewalker/emdash-example",
  "version": "0.0.1",
  "description": "EmDash (Astro CMS, blog-cloudflare template) built with Astro's Cloudflare adapter and run on cellb",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "astro build && node scripts/apply-assetsignore.mjs",
    "build:browser": "pnpm run build && tsx scripts/bundle-browser.ts",
    "dev:browser": "pnpm run build:browser && vite build --config browser/vite.sw.config.ts && vite browser --config browser/vite.config.ts",
    "test": "pnpm run build && vitest run",
    "test:browser": "pnpm run build:static && playwright test --config playwright.static.config.ts",
    "build:static": "pnpm run build:browser && node scripts/build-static.mjs",
    "serve:static": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist/static"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/react": "^7.1.8",
    "@emdash-cms/cloudflare": "^1.5.0",
    "astro": "^7.4.11",
    "emdash": "^1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@statewalker/cellb": "~0.8.8",
    "@statewalker/webrun-files-mem": "^0.10.3",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.161.0",
    "tsx": "^4.23.15"
  }
}
