        "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Observable notebook on the webrun platform</title>\n<link rel=\"stylesheet\" href=\"/nb/demo/_m/@observablehq/notebook-kit@2.10.1/dist/src/styles/dist/src/styles/index.css\">\n</head>\n<body>\n<div id=\"cell-1\"><h1>Observable notebook on the webrun platform</h1>\n<p>An <a href=\"https://github.com/observablehq/notebook-kit\">Observable Notebook Kit</a> document, compiled\nto a page inside a Durable Object. Its npm imports are served by the platform's module server.</p>\n</div>\n<div id=\"cell-2\"></div>\n<div id=\"cell-3\"></div>\n<div id=\"cell-4\"></div>\n<div id=\"cell-5\"></div>\n<script type=\"module\">\nimport {define} from \"/nb/demo/_m/@observablehq/notebook-kit@2.10.1/dist/src/runtime/index.js\";\ndefine({root: document.getElementById(\"cell-2\"), variables: [], expanded: []}, {\"id\":2,\"body\":(view,Inputs) => {\nconst count = view(Inputs.range([10, 200], {value: 60, step: 10, label: \"points\"}));\nreturn {count};\n},\"inputs\":[\"view\",\"Inputs\"],\"outputs\":[\"count\"],\"autodisplay\":false});\ndefine({root: document.getElementById(\"cell-3\"), variables: [], expanded: []}, {\"id\":3,\"body\":async (count) => {\nconst d3 = await import(\"/nb/demo/_m/d3@7.9.2/dist/d3.mjs\");\n\nconst points = d3.range(count).map((i) => ({x: i, y: Math.sin(i / 8) * 30 + d3.randomNormal(50, 4)()}));\nreturn {d3,points};\n},\"inputs\":[\"count\"],\"outputs\":[\"d3\",\"points\"],\"autodisplay\":false});\ndefine({root: document.getElementById(\"cell-4\"), variables: [], expanded: []}, {\"id\":4,\"body\":async (display,points) => {\nconst Plot = await import(\"/nb/demo/_m/@observablehq/plot@0.6.19/dist/plot.js\");\n\ndisplay(Plot.plot({height: 260, marks: [Plot.dot(points, {x: \"x\", y: \"y\", fill: \"steelblue\"}), Plot.lineY(points, Plot.windowY(9, {x: \"x\", y…\nreturn {Plot};\n},\"inputs\":[\"display\",\"points\"],\"outputs\":[\"Plot\"],\"autodisplay\":false});\ndefine({root: document.getElementById(\"cell-5\"), variables: [], expanded: []}, {\"id\":5,\"body\":(display,html,count,d3,points) => {\ndisplay(html`<p id=\"summary\">${count} points, mean y = ${d3.mean(points, (d) => d.y).toFixed(1)}</p>`);\n},\"inputs\":[\"display\",\"html\",\"count\",\"d3\",\"points\"],\"outputs\":[],\"autodisplay\":false});\n</script>\n</body>\n</html>",
