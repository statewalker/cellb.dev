---
// How a request moves through a builder: boxes left to right (top to bottom on a phone), each
// with what it is and what it does.
interface Props {
  steps: { label: string; detail: string; kind?: "client" | "object" | "external" }[];
  caption?: string;
}

const { steps, caption } = Astro.props;
const box = {
  client: "border-dashed bg-background",
  object: "border-primary/40 bg-primary/5",
  external: "border-dashed bg-muted/50",
};
---

<figure class="not-prose my-6">
  <ol class="my-0 list-none pl-0 space-y-0 flex flex-col items-stretch gap-2 md:flex-row md:items-stretch">
    {steps.map((s, i) => (
      <>
        {i > 0 && (
          <li aria-hidden="true" class="flex items-center justify-center text-muted-foreground">
            <span class="md:hidden">↓</span><span class="hidden md:inline">→</span>
          </li>
        )}
        <li class:list={["min-w-0 flex-1 rounded-lg border p-3", box[s.kind ?? "object"]]}>
          <p class="my-0 font-mono text-xs font-semibold text-foreground">{s.label}</p>
          <p class="mt-1 mb-0 text-xs leading-5 text-muted-foreground">{s.detail}</p>
        </li>
      </>
    ))}
  </ol>
  {caption && <figcaption class="mt-2 text-xs text-muted-foreground">{caption}</figcaption>}
</figure>
