---
import CodeBlock from "@/components/CodeBlock.astro";
import Tabs from "@/components/ui/Tabs.astro";
import { langOf } from "@/lib/builders";

// An example's input files, one tab each.
interface Props {
  /** Path as shown → file contents. */
  files: Record<string, string>;
  /** Where the files live in the repository, shown above the tabs. */
  source?: { label: string; href: string };
}

const { files, source } = Astro.props;
const entries = Object.entries(files);
---

<div class="not-prose my-6">
  {source && (
    <p class="mt-0 mb-2 font-mono text-xs text-muted-foreground">
      <a href={source.href} class="text-muted-foreground no-underline hover:text-foreground hover:underline">{source.label}</a>
    </p>
  )}
  <Tabs labels={entries.map(([p]) => p)}>
    {entries.map(([path, code], i) => (
      <div slot={`tab-${i}`}>
        <CodeBlock lang={langOf(path)} code={code.trimEnd()} title={path} class="!my-0 max-h-[32rem]" />
      </div>
    ))}
  </Tabs>
</div>
