---
import { REPO } from "@/lib/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Badge from "./ui/Badge.astro";

const path = Astro.url.pathname;
const nav = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/how-it-works", label: "How it works" },
  { href: "/#use-cases", label: "Use cases" },
  { href: "/#compare", label: "vs celld" },
];
---

<header class="sticky top-0 z-40 w-full border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <Logo />
    <Badge variant="outline" class="hidden font-mono text-[10px] sm:inline-flex">v0.0.1 · preview</Badge>
    <nav class="hidden items-center gap-5 text-sm md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition-colors hover:text-foreground",
            path === item.href || (item.href !== "/docs" && path.startsWith(item.href))
              ? "text-foreground"
              : "text-muted-foreground",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a
        href={REPO}
        aria-label="GitHub"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground"
      >
        <Icon name="github" />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
