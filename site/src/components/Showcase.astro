---
// The home page's real apps, from the catalog (lib/showcase.ts) the /examples hub renders too.
import { docHref } from "@/lib/docs";
import { byKind, entry } from "@/lib/showcase";
import Icon from "./Icon.astro";
import Card from "./ui/Card.astro";

const apps = [entry("emdash-live"), entry("astro-live")].map((e) => ({
  image: e.image?.src,
  alt: e.image?.alt,
  title:
    e.id === "emdash-live"
      ? "A CMS in a tab, from static files"
      : "Built from source, in the same tab",
  body: e.long ?? e.body,
  href: docHref(e.readme ?? ""),
  demo: e.try,
}));
const more = byKind("app", "agents").map((e) => [e.title, e.body, e.readme ?? ""] as const);
---

<div class="grid gap-6 lg:grid-cols-2">
  {apps.map((a) => (
    <Card class="overflow-hidden">
      <div class="border-b bg-muted/40 p-3">
        <img
          src={a.image}
          alt={a.alt}
          loading="lazy"
          width="1280"
          height="860"
          class="w-full rounded-md border bg-white object-cover object-top shadow-xs"
        />
      </div>
      <div class="space-y-2 p-6">
        <h3 class="font-medium">{a.title}</h3>
        <p class="text-sm leading-6 text-muted-foreground">{a.body}</p>
        <div class="flex flex-wrap gap-x-5 gap-y-1">
          <a href={a.demo} class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline">
            Open the live demo <Icon name="externalLink" class="size-3" />
          </a>
          <a href={a.href} class="inline-flex items-center gap-1 text-sm text-primary hover:underline">
            How it is wired <Icon name="externalLink" class="size-3" />
          </a>
        </div>
      </div>
    </Card>
  ))}
</div>
<div class="mt-6 grid gap-4 sm:grid-cols-2">
  {more.map(([name, body, path]) => (
    <a href={docHref(path)} class="group rounded-xl border bg-card p-5 transition-colors hover:border-primary/40">
      <p class="font-mono text-sm font-medium group-hover:text-primary">{name}</p>
      <p class="mt-1 text-sm text-muted-foreground">{body}</p>
    </a>
  ))}
</div>
