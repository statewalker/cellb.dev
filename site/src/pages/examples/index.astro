---
import Icon from "@/components/Icon.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import Base from "@/layouts/Base.astro";
import { docHref, examplePages, pageHref } from "@/lib/docs";
import { type Example, exampleHref, examples } from "@/lib/examples";
import { LIVE_DEMOS, SANDBOX } from "@/lib/site";

const groups: { origin: Example["origin"]; title: string; body: string }[] = [
  {
    origin: "celld",
    title: "celld's examples",
    body: "The example projects in celld's repository, copied without changes. Each page links to the project in denoland/celld.",
  },
  {
    origin: "cellb",
    title: "CellB's probe projects",
    body: "Projects written for CellB's conformance tests, for the API celld's examples do not reach: limits, errors, edge cases. They run on celld as well, and celld's answers are the expected ones.",
  },
  {
    origin: "workerd",
    title: "workerd's tests",
    body: "workerd's tests of Durable Objects, WebSockets and Worker Loader, from Cloudflare's workerd repository, run inside a Worker on celld and on CellB.",
  },
];

// Whole apps with a docs page of their own and no scenario: reachable from here too.
const APPS_ABOUT: Record<string, string> = {
  "examples/flue":
    "A Flue agent app, built with Flue's own Cloudflare build and run on CellB, against a fake model.",
  "examples/agents":
    "The pi and opencode coding-agent frameworks in Durable Objects on CellB, against a fake OpenAI-compatible model.",
  "examples/platform-demos":
    "Whole apps built with their own toolchains, then bundled or compiled by the platform, and run on Wrangler, celld and CellB.",
};
const apps = examplePages.filter((p) => p.slug in APPS_ABOUT);
---

<Base title="Examples · CellB" description="Every scenario CellB is checked against, runnable in your browser next to the answers recorded on celld (or workerd, where marked).">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="max-w-3xl space-y-3">
      <p class="font-mono text-sm text-primary">// examples</p>
      <h1 class="text-4xl font-semibold tracking-tight">Run every example in your browser</h1>
      <p class="text-muted-foreground">
        These are the {examples.length} scenarios CellB is tested with: a project and the requests
        sent to it. Each one ran on celld and its answers were recorded; where a page is marked
        "judged by workerd", the answers are compared with workerd's instead. On each page you can
        run the same project on CellB in this tab and compare the answers line by line. The projects are bundled when the site is built,
        so a run starts in a second or two.
      </p>
    </div>
    <div id="live-demos" class="mt-12 scroll-mt-20">
      <h2 class="text-2xl font-semibold tracking-tight">Live demos: whole apps in a tab</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        EmDash, a Cloudflare app CellB did not write, served from static files, and Astro apps
        (EmDash among them) built from their sources in the tab. The tab runs the Worker, its
        Durable Objects, D1, KV and R2. Keep the host tab open while you use a site. CellB sandbox
        does the same for a project folder of your own.
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {Object.values(LIVE_DEMOS).map((d) => (
          <Card class="flex h-full flex-col p-5">
            <a href={d.href} class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
              {d.title} <Icon name="externalLink" class="size-3" />
            </a>
            <p class="mt-2 flex-1 text-sm text-muted-foreground">{d.body}</p>
            <a href={docHref(d.readme)} class="mt-3 text-sm text-primary hover:underline">How it is wired</a>
          </Card>
        ))}
        <Card class="flex h-full flex-col p-5">
          <a href={SANDBOX.href} class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
            {SANDBOX.title} <Icon name="arrowRight" class="size-3" />
          </a>
          <p class="mt-2 flex-1 text-sm text-muted-foreground">{SANDBOX.body}</p>
          <a href={SANDBOX.about} class="mt-3 text-sm text-primary hover:underline">How it is wired</a>
        </Card>
      </div>
    </div>
    {groups.map((g) => {
      const list = examples.filter((e) => e.origin === g.origin);
      return (
        <div id={g.origin} class="mt-12 scroll-mt-20">
          <h2 class="text-2xl font-semibold tracking-tight">{g.title}</h2>
          <p class="mt-2 max-w-3xl text-sm text-muted-foreground">{g.body}</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((e) => (
              <a href={exampleHref(e.name)} class="group">
                <Card class="h-full p-4 transition-colors group-hover:border-primary/40">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono text-sm font-medium">{e.name}</span>
                    {e.knownGap && <Badge variant="outline">known difference</Badge>}
                    {e.judge === "workerd" && <Badge variant="outline">judged by workerd</Badge>}
                  </div>
                  <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{e.about}</p>
                </Card>
              </a>
            ))}
          </div>
        </div>
      );
    })}
    <div id="apps" class="mt-12 scroll-mt-20">
      <h2 class="text-2xl font-semibold tracking-tight">Apps tested on CellB</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Whole applications CellB did not write, checked by their own end-to-end tests rather than
        by recorded scenarios. Each page says how to run it.
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {apps.map((p) => (
          <a href={pageHref(p)} class="group">
            <Card class="h-full p-4 transition-colors group-hover:border-primary/40">
              <span class="font-medium">{p.label}</span>
              <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{APPS_ABOUT[p.slug]}</p>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
