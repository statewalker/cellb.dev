---
// /examples: the one page with every example and demo of the site, from the catalog
// (lib/showcase.ts) and the recorded scenarios (lib/examples.ts). The ids of its sections are
// linked from elsewhere (#try, #live-demos, #containers, #apps, #areas, #scenarios, #celld,
// #cellb, #workerd): keep them.
import Icon from "@/components/Icon.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import Base from "@/layouts/Base.astro";
import { docHref } from "@/lib/docs";
import { type Example, exampleHref, examples } from "@/lib/examples";
import { byKind, type Entry, entry, liveGroup } from "@/lib/showcase";
import { repoFile } from "@/lib/site";

const groups: { origin: Example["origin"]; title: string; body: string }[] = [
  {
    origin: "celld",
    title: "celld's examples",
    body: "The example projects in celld's repository, copied without changes. Each page links to the project in denoland/celld.",
  },
  {
    origin: "cellb",
    title: "CellB's probe projects",
    body: "Projects written for CellB's conformance tests, for the API celld's examples do not reach: limits, errors, edge cases. They run on celld as well, and celld's answers are the expected ones.",
  },
  {
    origin: "workerd",
    title: "workerd's tests",
    body: "workerd's tests of Durable Objects, WebSockets and Worker Loader, from Cloudflare's workerd repository, run inside a Worker on celld and on CellB.",
  },
];

const jump = [
  ["#try", "Try it now"],
  ["#apps", "Apps tested on CellB"],
  ["#areas", "By area"],
  ["#scenarios", "Conformance scenarios"],
] as const;

const tryGroups: { id: string; title: string; body: string; items: Entry[] }[] = [
  {
    id: "live-demos",
    title: "Whole apps in a tab",
    body: "Cloudflare apps CellB did not write, and CellB's own sandbox. The tab runs the Worker, its Durable Objects, D1, KV and R2; keep it open while you use the app.",
    items: liveGroup("apps"),
  },
  {
    id: "containers",
    title: "Containers in a tab",
    body: "Programs that are not JavaScript, next to the page: one demo per engine of @statewalker/cellb-containers.",
    items: liveGroup("containers"),
  },
  {
    id: "on-this-site",
    title: "A Durable Object on this site",
    body: "The demo on the home page, with its code next to it.",
    items: liveGroup("core"),
  },
];

const howWired = (e: Entry) => e.read ?? (e.readme ? docHref(e.readme) : undefined);
const apps = byKind("app");
const builders = byKind("area", "builders");
const containerProjects = byKind("area", "containers");
---

<Base
  title="Examples & demos · CellB"
  description="Live demos to open in your tab, apps tested on CellB, worked examples per area, and the scenarios CellB is checked against."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="max-w-3xl space-y-3">
      <p class="font-mono text-sm text-primary">// examples & demos</p>
      <h1 class="text-4xl font-semibold tracking-tight">Examples and demos</h1>
      <p class="text-muted-foreground">
        Everything that shows CellB at work, from what takes a click to what takes a read: live
        demos that open in this browser, whole apps tested on CellB, a worked example for each
        builder and for containers, and the {examples.length} scenarios CellB is checked against,
        each runnable here next to the answers recorded on celld.
      </p>
      <nav aria-label="On this page" class="flex flex-wrap gap-2 pt-2">
        {jump.map(([href, label]) => (
          <a href={href} class="rounded-full border px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground">
            {label}
          </a>
        ))}
      </nav>
    </div>

    <div id="try" class="mt-12 scroll-mt-20">
      <h2 class="text-2xl font-semibold tracking-tight">Try it now</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Opens and runs in your browser; nothing to install. Chrome or another Chromium-based browser
        for the containers demos.
      </p>
      {tryGroups.map((g) => (
        <div id={g.id} class="mt-8 scroll-mt-20">
          <h3 class="text-lg font-semibold tracking-tight">{g.title}</h3>
          <p class="mt-1 max-w-3xl text-sm text-muted-foreground">{g.body}</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((d) => (
              <Card class="flex h-full flex-col overflow-hidden">
                {d.image && (
                  <a href={d.try} class="block border-b bg-muted/40 p-2">
                    <img src={d.image.src} alt={d.image.alt} loading="lazy" class="aspect-[16/10] w-full rounded border bg-white object-cover object-top" />
                  </a>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <a href={d.try} class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
                    {d.title} <Icon name={d.external ? "externalLink" : "arrowRight"} class="size-3" />
                  </a>
                  {d.engine && <span class="mt-1 text-xs uppercase tracking-wide text-muted-foreground">{d.engine}</span>}
                  <p class="mt-2 flex-1 text-sm text-muted-foreground">{d.body}</p>
                  {howWired(d) && (
                    <a href={howWired(d)} class="mt-3 text-sm text-primary hover:underline">How it is wired</a>
                  )}
                </div>
              </Card>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="apps" class="mt-14 scroll-mt-20">
      <h2 class="text-2xl font-semibold tracking-tight">Apps tested on CellB</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Whole applications CellB did not write, checked by their own end-to-end tests, locally and
        in CI, rather than by recorded scenarios. Each page says how to run it.
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {apps.map((a) => (
          <Card class="flex h-full flex-col p-4">
            <a href={docHref(a.readme ?? "")} class="font-medium hover:text-primary">{a.title}</a>
            <p class="mt-2 flex-1 text-sm text-muted-foreground">{a.body}</p>
            {a.related && entry(a.related).try && (
              <a href={entry(a.related).try} class="mt-3 inline-flex items-center gap-1 text-sm text-primary hover:underline">
                Live demo <Icon name="externalLink" class="size-3" />
              </a>
            )}
          </Card>
        ))}
      </div>
    </div>

    <div id="areas" class="mt-14 scroll-mt-20">
      <h2 class="text-2xl font-semibold tracking-tight">By area</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        Worked examples of the parts of the platform, with the pages that explain them.
      </p>
      <div id="builders" class="mt-8 scroll-mt-20">
        <h3 class="text-lg font-semibold tracking-tight">
          <a href="/builders" class="hover:text-primary">Builders</a>
        </h3>
        <p class="mt-1 max-w-3xl text-sm text-muted-foreground">
          The platform's builders, each with a working example run against the platform and checked in Chromium.
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {builders.map((b) => (
            <a href={b.read} class="group">
              <Card class="h-full overflow-hidden transition-colors group-hover:border-primary/40">
                {b.image && (
                  <div class="border-b bg-muted/40 p-2">
                    <img src={b.image.src} alt={b.image.alt} loading="lazy" class="aspect-[16/10] w-full rounded border bg-white object-cover object-left-top" />
                  </div>
                )}
                <div class="p-4">
                  <span class="font-medium">{b.title}</span>
                  <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{b.body}</p>
                </div>
              </Card>
            </a>
          ))}
        </div>
      </div>
      <div id="container-projects" class="mt-8 scroll-mt-20">
        <h3 class="text-lg font-semibold tracking-tight">
          <a href="/containers" class="hover:text-primary">Containers</a>
        </h3>
        <p class="mt-1 max-w-3xl text-sm text-muted-foreground">
          Projects of <code>@statewalker/cellb-containers</code>: a container per Durable Object on
          Wasmer, a pool for custom code, a FilesApi mounted into a container. The{" "}
          <a href="/containers" class="text-primary hover:underline">Containers</a> page compares the
          two engines.
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {containerProjects.map((c) => (
            <a href={repoFile(c.source ?? "")} class="group">
              <Card class="h-full p-4 transition-colors group-hover:border-primary/40">
                <span class="inline-flex items-center gap-1 font-mono text-sm font-medium">
                  {c.title} <Icon name="externalLink" class="size-3" />
                </span>
                <p class="mt-2 text-sm text-muted-foreground">{c.body}</p>
              </Card>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div id="scenarios" class="mt-14 scroll-mt-20">
      <h2 class="text-2xl font-semibold tracking-tight">Conformance scenarios</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted-foreground">
        The {examples.length} scenarios CellB is tested with: a project and the requests sent to it.
        Each one ran on celld and its answers were recorded; where a page is marked "judged by
        workerd", the answers are compared with workerd's instead. On each page you can run the same
        project on CellB in this tab and compare the answers line by line. The projects are bundled
        when the site is built, so a run starts in a second or two.
      </p>
      {groups.map((g) => {
        const list = examples.filter((e) => e.origin === g.origin);
        return (
          <div id={g.origin} class="mt-8 scroll-mt-20">
            <h3 class="text-lg font-semibold tracking-tight">{g.title}</h3>
            <p class="mt-1 max-w-3xl text-sm text-muted-foreground">{g.body}</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {list.map((e) => (
                <a href={exampleHref(e.name)} class="group">
                  <Card class="h-full p-4 transition-colors group-hover:border-primary/40">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-mono text-sm font-medium">{e.name}</span>
                      {e.knownGap && <Badge variant="outline">known difference</Badge>}
                      {e.judge === "workerd" && <Badge variant="outline">judged by workerd</Badge>}
                    </div>
                    <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{e.about}</p>
                  </Card>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Base>
