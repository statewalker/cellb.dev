---
import CodeBlock from "@/components/CodeBlock.astro";
import Badge from "@/components/ui/Badge.astro";
import Docs from "@/layouts/Docs.astro";
import { docHref } from "@/lib/docs";
import { REPO } from "@/lib/site";
import cellb from "../../../../packages/cellb/package.json";

const nodeCode = `import { loadProject } from "@statewalker/cellb/node";

// A folder with wrangler.json(c) and its \`main\`, bundled with esbuild as it loads
const project = await loadProject("./counter", { data: "./data" });

const res = await project.fetch(new Request("http://localhost/increment?name=alpha"));
console.log(project.unsupported); // configuration CellB does not run, e.g. []
await project.close();`;

const buildCode = `npx cellb build ./counter --out public/apps/counter`;

const browserCode = `// In a Dedicated Worker
import { loadProject } from "@statewalker/cellb/browser";

// The folder \`cellb build\` wrote, served by any static host
const project = await loadProject("/apps/counter/", { data: "counter" });

const res = await project.fetch(new Request("http://localhost/increment?name=alpha"));
await project.close();`;

const runtimeCode = `import { createCellRuntime, DurableObject } from "@statewalker/cellb";
import { nodeSqliteOpener } from "@statewalker/cellb/node";

class Counter extends DurableObject {
  increment(): number {
    const sql = this.ctx.storage.sql;
    sql.exec("CREATE TABLE IF NOT EXISTS c (id INTEGER PRIMARY KEY, n INTEGER)");
    sql.exec("INSERT INTO c (id, n) VALUES (1, 1) ON CONFLICT(id) DO UPDATE SET n = n + 1");
    return sql.exec<{ n: number }>("SELECT n FROM c WHERE id = 1").one().n;
  }
}

const runtime = createCellRuntime({
  worker: {
    Counter,
    default: {
      fetch: async (req: Request, env: any) =>
        Response.json({ n: await env.COUNTER.getByName(new URL(req.url).pathname).increment() }),
    },
  },
  durableObjects: { COUNTER: { className: "Counter" } },
  // In memory. nodeSqliteOpener("./data") keeps a file per cell in ./data, which must exist:
  // the opener does not create it (mkdirSync("./data", { recursive: true }) first)
  openSql: nodeSqliteOpener(),
});

const res = await runtime.fetch(new Request("http://local/counter/a")); // {"n":1}
await runtime.close();`;

const browserRuntimeCode = `import sqlite3InitModule from "@sqlite.org/sqlite-wasm";
import { browserProjectRuntime } from "@statewalker/cellb/browser";

const host = await browserProjectRuntime({
  config,            // the parsed wrangler.jsonc
  code: { bundle },  // main, bundled for browsers (or { site } for the in-browser HTTP server)
  sqlite3: await sqlite3InitModule(),
  pool: "my-app",    // the OPFS SQLite pool; one per worker
  filesDir: "my-app-files",
});
const res = await host.runtime.fetch(new Request("http://browser/"));`;

const fleetCode = `import { celldBucket } from "@statewalker/cellb";
import { loadNodeProject, nodeSqliteOpener, sqliteObjectStore } from "@statewalker/cellb/node";
import { MemFilesApi } from "@statewalker/webrun-files-mem";

const dir = "./counter"; // wrangler.jsonc and its \`main\`
const { runtime, unsupported } = await loadNodeProject(dir, {
  openSql: nodeSqliteOpener(), // in memory: every cell is restored from the bucket on first use
  files: new MemFilesApi(), // blob store for large KV values
  storage: celldBucket(sqliteObjectStore(\`\${dir}/.celld/dev/objects.sqlite3\`), { node: "cellb-1" }),
});
console.log(unsupported); // configuration CellB does not support, e.g. []
await runtime.fetch(new Request("http://localhost/increment?name=a"));
await runtime.close(); // releases the cells, so celld can take them at once`;
---

<Docs title="Getting started" description="Run a Worker and its Durable Objects with CellB in Node and in a browser, with one loadProject call.">
  <Badge variant="brand" class="mb-4">@statewalker/cellb {cellb.version} · on npm</Badge>
  <h1>Getting started</h1>
  <p>
    CellB (<code>@statewalker/cellb</code>) is a Durable Objects runtime written in TypeScript. It
    runs the same Workers code in a browser and in Node. A Worker module and its Durable Object
    classes get synchronous SQLite storage, input and output gates, stubs with
    <code>fetch</code> and RPC, alarms, WebSockets, Worker Loaders and facets, all without
    modification.
  </p>
  <p>
    Two words come up on every page. <strong>celld</strong> is Deno's server that runs Workers
    projects on a fleet of machines sharing one bucket; CellB answers its recorded requests the same
    way and stores data in its format. A <strong>cell</strong> is one Durable Object instance: its
    name, its SQLite database, and exactly one owner at a time. The
    <a href={docHref("packages/cellb/CONTEXT.md")}>glossary</a> defines the rest.
  </p>

  <h2>Install</h2>
  <CodeBlock code={`npm install @statewalker/cellb\nnpm install esbuild   # for loadProject and cellb build on Node (an optional peer dependency)`} />
  <p>
    The published package is JavaScript with type declarations. Node 22.13 or later is needed for
    <code>node:sqlite</code>. Two more entry points have optional peer dependencies of their own:
  </p>
  <ul>
    <li><code>@statewalker/cellb/bundle</code> needs <code>@statewalker/webrun-bundler</code>, and the caller passes esbuild-wasm, initialized;</li>
    <li><code>@statewalker/cellb/site</code> needs <code>@statewalker/webrun-modules</code>, <code>@statewalker/webrun-site-builder</code> and <code>@statewalker/webrun-site-host</code>.</li>
  </ul>
  <p>
    In a browser app, the bundler must handle
    <code>new Worker(new URL("…", import.meta.url))</code>, which Vite does. The sources live in
    the <a href={REPO}>cellb.dev monorepo</a>.
  </p>

  <h2>Load a project</h2>
  <p>
    <code>loadProject(source, options)</code> has the same name and options in Node and in a
    browser. In Node it takes a wrangler project folder and bundles its <code>main</code> with
    esbuild as it loads it. <code>data</code> is where the cells are stored: a directory in Node
    (created if missing), an OPFS name in a browser. Leave it out to keep everything in memory.
  </p>
  <CodeBlock lang="ts" title="node.ts" code={nodeCode} />
  <p>
    A browser loads a project built ahead of time, on Node. The folder holds
    <code>wrangler.json</code>, <code>worker.js</code>, <code>assets/</code> and
    <code>cellb.json</code>, the manifest of the assets, since a static host cannot list a folder.
  </p>
  <CodeBlock lang="sh" title="terminal" code={buildCode} />
  <p>
    Then, in a Dedicated Worker, the browser's <code>loadProject</code> loads that folder by URL.
    Its <code>data</code> defaults to the project's <code>name</code>, and code loaded through a
    Worker Loader runs in a Dedicated Worker of its own by default (<code>isolateScript</code>).
  </p>
  <CodeBlock lang="ts" title="worker.ts" code={browserCode} />
  <p>
    A project is a <code>(Request) ⇒ Response</code> handler. Mount <code>project.fetch</code> on
    <code>node:http</code>, a ServiceWorker or a test, and call <code>project.close()</code> when you
    are done: it takes final backups and closes every database. A browser can also compile a
    project from its sources, with no build step: see
    <a href="/docs/from-sources">Running from sources</a>.
  </p>

  <h2>Entry points</h2>
  <p>The package has three entry points, one per platform, and more for bundling and hosting:</p>
  <table>
    <thead><tr><th>Import</th><th>What it gives</th></tr></thead>
    <tbody>
      <tr><td><code>@statewalker/cellb</code></td><td>The runtime (<code>createCellRuntime</code>, <code>createProjectRuntime</code> with <code>loadProjectBindings</code>), <code>DurableObject</code> and <code>WorkerEntrypoint</code>, the ports and <code>CellStorage</code>, <code>celldBucket</code>, the object stores (<code>s3ObjectStore</code>, <code>memoryObjectStore</code>, <code>filesApiObjectStore</code>), <code>filesApiLtxLog</code>, <code>filesApiChangeLog</code>, <code>filesApiBackup</code>, <code>wasmMemoryOpener</code> (in-memory SQLite WASM), links over ports, <code>CellRouter</code>, <code>createShardWorker</code>, the WebSocket classes, and the errors embedders catch</td></tr>
      <tr><td><code>@statewalker/cellb/node</code></td><td><code>loadProject</code> and <code>buildProject</code> (the <code>cellb build</code> command), <code>nodeSqliteOpener</code>, <code>sqliteObjectStore</code> (celld dev's local bucket), <code>loadNodeProject</code>, <code>applyNodeD1Migrations</code>, and celld's peer protocol (<code>startCelldPeerServer</code>, <code>celldPeers</code>)</td></tr>
      <tr><td><code>@statewalker/cellb/browser</code></td><td><code>loadProject</code> (a <code>cellb build</code> folder by URL, or sources with a compiler), <code>browserProjectRuntime</code>, <code>startProjectShards</code>, <code>joinProjectShards</code> and <code>serveProjectShard</code> (shards in workers and tabs), <code>installProjectRouter</code> (the ServiceWorker side), <code>sahpoolOpener</code>, <code>idbObjectStore</code>, <code>serviceWorkerConnector</code></td></tr>
      <tr><td><code>@statewalker/cellb/tabs</code></td><td>The tab side and the ServiceWorker side of a project shared by the tabs (<code>joinProjectShards</code>, <code>installProjectRouter</code>, <code>shardOwner</code>) without the shard runtime: what a page and its ServiceWorker import</td></tr>
      <tr><td><code>@statewalker/cellb/site</code></td><td><code>createProjectSite</code>: a project's sources compiled in the browser and served by an in-browser HTTP server (<code>{"browserProjectRuntime({ site })"}</code>); <code>siteCompiler</code> for <code>loadProject</code>, and <code>siteHostOverPort</code> / <code>hostSitesForWorker</code> to host a worker's site from its page. Needs the optional peers <code>@statewalker/webrun-modules</code>, <code>@statewalker/webrun-site-builder</code> and <code>@statewalker/webrun-site-host</code></td></tr>
      <tr><td><code>@statewalker/cellb/bundle</code></td><td><code>bundleCompiler</code>: a project's sources bundled in the browser for <code>loadProject</code>, with webrun-bundler on esbuild-wasm. Needs the optional peer <code>@statewalker/webrun-bundler</code>; the caller passes esbuild-wasm, initialized</td></tr>
      <tr><td><code>@statewalker/cellb/host-modules</code></td><td>For bundlers other than CellB's own (webrun-bundler in a browser, say): the sources of <code>cloudflare:workers</code>, <code>node:*</code> and the Workers globals as CellB's realms provide them (<code>cellbHostModule</code>, <code>CELLS_GLOBALS_MODULE</code>)</td></tr>
      <tr><td><code>@statewalker/cellb/isolate-worker</code></td><td>The Dedicated Worker that runs a Worker Loader's Worker in a realm of its own (<code>isolateScript</code>)</td></tr>
    </tbody>
  </table>

  <h2>Lower-level calls</h2>
  <p>
    <code>loadProject</code> is built on calls you can use directly when you need more control:
    <code>createCellRuntime</code> for a Worker you hand over as a module object,
    <code>loadNodeProject</code> for a wrangler project in Node with your own SQLite opener, files
    and storage, and <code>browserProjectRuntime</code> for a bundle in a browser worker.
  </p>

  <h3>A Durable Object in Node: createCellRuntime</h3>
  <CodeBlock lang="ts" title="counter.ts" code={runtimeCode} />

  <h3>A bundle in a browser worker: browserProjectRuntime</h3>
  <p>
    In a browser, cells live in SQLite WASM inside a Dedicated Worker, and requests arrive
    through a ServiceWorker. <code>browserProjectRuntime</code> does not isolate Worker Loader code
    unless it is given an <code>isolateScript</code>.
  </p>
  <CodeBlock lang="ts" title="worker.ts" code={browserRuntimeCode} />

  <p>
    Where the cells' data lives is a choice of the <code>bucket</code> option (of
    <code>browserProjectRuntime</code>, and of the browser's <code>loadProject</code>):
  </p>
  <table>
    <thead><tr><th>Storage</th><th>What it does</th></tr></thead>
    <tbody>
      <tr><td>an OPFS pool (default)</td><td>One SQLite file per cell in the worker's opfs-sahpool pool. Needs no COOP/COEP headers; a pool belongs to one worker</td></tr>
      <tr><td><code>{"{ ltx, node }"}</code></td><td>Each cell as celld keeps it: a snapshot and one LTX file per commit in OPFS, read page by page, so a cell's memory is its page cache. Compacts itself; needs cross-origin isolation</td></tr>
      <tr><td><code>{"{ idb, node }"}</code></td><td>SQLite in memory, persisted through page-level logs in IndexedDB, whose conditional writes are atomic across tabs and workers</td></tr>
      <tr><td><code>{"{ opfs, node }"}</code></td><td>A celld-layout bucket in this origin's OPFS: persistence without a server. Conditional writes are atomic only within one writer, so one tab or worker at a time should own its cells</td></tr>
      <tr><td><code>{"{ s3, node }"}</code></td><td>A celld fleet bucket on S3 (or an S3-compatible store), shared with celld and Node nodes. The bucket must allow CORS for the page's origin, or be reached through a same-origin proxy</td></tr>
      <tr><td><code>{"{ store, node }"}</code></td><td>Any <code>ObjectStore</code> you construct yourself</td></tr>
    </tbody>
  </table>

  <h2>Join a celld fleet</h2>
  <p>
    Give the runtime a <code>celldBucket</code> and it becomes a node of a celld fleet. It uses the
    same bucket layout, ownership records and LTX log, so a cell can move between celld and CellB
    with no conversion. This example uses the bucket <code>celld dev</code> keeps on disk
    (<code>.celld/dev/objects.sqlite3</code>, there once <code>celld dev</code> has run). For a real
    fleet, pass <code>s3ObjectStore(…)</code>; <code>loadProject(dir, {"{ bucket }"})</code> takes
    the same <code>celldBucket(…)</code>.
  </p>
  <CodeBlock lang="ts" title="fleet.ts" code={fleetCode} />

