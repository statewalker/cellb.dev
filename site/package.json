{
  "name": "@statewalker/cellb-site",
  "private": true,
  "type": "module",
  "description": "The cellb.dev website (Astro, Tailwind CSS, shadcn/ui tokens).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "examples": "tsx scripts/build-examples.ts",
    "dev": "tsx scripts/build-examples.ts && astro dev",
    "build": "tsx scripts/build-examples.ts && astro build && node scripts/build-sandbox.mjs && node scripts/compress.mjs",
    "sandbox": "node scripts/build-sandbox.mjs",
    "preview": "astro preview",
    "check:examples": "node scripts/check-examples.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "record:builders": "tsx scripts/record-builders.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@statewalker/cellb": "workspace:*",
    "@statewalker/webrun-bundler": "^0.1.1",
    "@statewalker/webrun-files-mem": "^0.10.3",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.28.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "sqlite-vec-wasm-demo": "0.1.6",
    "tsx": "^4.23.15"
  }
}
