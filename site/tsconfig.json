{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "../packages/cellb/src/node-compat/shims.d.ts"],
  // The builders' examples (src/builders/examples) are user projects bundled in the browser with
  // their own dependencies, not part of this site's program.
  "exclude": ["dist", "src/demo/counter/project", "src/builders/examples"],
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    // cellb's sources (imported through the workspace) mark their vendored JS imports with
    // @ts-expect-error, which allowJs would leave unused.
    "allowJs": false
  }
}
