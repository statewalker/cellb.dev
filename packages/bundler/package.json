{
  "name": "@statewalker/cellb-bundler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git",
    "directory": "packages/bundler"
  },
  "description": "The bundler: a project (an Astro project included) bundled into a no_bundle wrangler project that Wrangler, celld and cellb run, in a Durable Object or on the Node runner (bin/webrun-build.ts).",
  "exports": {
    ".": "./src/build.ts",
    "./any": "./src/any.ts",
    "./compat": "./src/compat.ts",
    "./job": "./src/job.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/cellb-platform-core": "workspace:*",
    "@statewalker/cellb-astro-builder": "workspace:*",
    "@statewalker/webrun-bundler": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-node": "catalog:",
    "@statewalker/webrun-modules": "catalog:",
    "@astrojs/compiler-rs": "catalog:",
    "esbuild": "catalog:",
    "esbuild-wasm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  },
  "bin": {
    "webrun-build": "bin/webrun-build.ts"
  }
}
