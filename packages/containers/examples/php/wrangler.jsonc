{
  "name": "containers-php",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "PhpSite" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhpSite"] }],
  // celld builds ./Dockerfile; cellb runs the same www/ in a Wasmer (WASIX) PHP.
  "containers": [{ "class_name": "PhpSite", "image": "./Dockerfile", "instance_type": "basic" }],
  // cellb's image for the same class: WASIX packages, the project's files, the entrypoint.
  // celld ignores this key; cellb gives objects of the class ctx.container with it.
  "cellb": {
    "containers": {
      "PhpSite": {
        "packages": ["php/php-32"],
        "files": { "www/index.php": "./www/index.php" },
        "entrypoint": [
          "php",
          "-S",
          "0.0.0.0:8080",
          "-t",
          "/workspace/www",
          "/workspace/www/index.php"
        ]
      }
    }
  }
}
