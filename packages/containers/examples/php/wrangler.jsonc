{
  "name": "containers-php",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "PhpSite" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhpSite"] }],
  // celld builds ./Dockerfile; cellb runs the same www/ in a Wasmer (WASIX) PHP.
  "containers": [{ "class_name": "PhpSite", "image": "./Dockerfile", "instance_type": "basic" }],
  "rules": [{ "type": "Text", "globs": ["**/*.php"] }]
}
