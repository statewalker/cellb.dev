{
  "name": "@statewalker/astro-builder",
  "version": "0.0.0",
  "private": true,
  "description": "An Astro SSR build (Astro's compiler + esbuild-wasm over a FilesApi) that runs in a browser, a worker or Node, producing one Worker module and its client assets",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git",
    "directory": "packages/astro-builder"
  },
  "homepage": "https://github.com/statewalker/cellb.dev/tree/main/packages/astro-builder#readme",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/routes.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "1.2.6",
    "@statewalker/webrun-bundler": "link:../../../webrun-sites/packages/webrun-bundler",
    "@statewalker/webrun-files": "^0.10.0",
    "@statewalker/webrun-modules": "0.3.6"
  },
  "peerDependencies": {
    "esbuild-wasm": ">=0.28.2"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@statewalker/cellb": "workspace:*",
    "@statewalker/webrun-files-mem": "^0.10.0",
    "@types/node": "catalog:",
    "esbuild-wasm": "0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
