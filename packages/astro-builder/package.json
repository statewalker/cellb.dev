    "./astro-plugin": "./src/astro-plugin.ts",
    "./integrations": "./src/integrations.ts",
    "./routes": "./src/routes.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
