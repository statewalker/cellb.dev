{
  "name": "runtime-api",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "services": [
    { "binding": "SELF", "service": "runtime-api" },
    { "binding": "MATH", "service": "runtime-api", "entrypoint": "MathApi" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "runtime-api-kv" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
