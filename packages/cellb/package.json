{
  "name": "@statewalker/cellb",
  "version": "0.0.1",
  "description": "cellb: isomorphic Durable Objects runtime (celld/Cloudflare-compatible surface) for browsers and servers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./browser": "./src/browser.ts",
    "./host-modules": "./src/project/host-modules.ts",
    "./isolate-worker": "./src/isolate/isolate-worker.ts"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run test/",
    "test:e2e": "vitest run e2e/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e-browser/pages/tsconfig.json",
    "mutate": "node scripts/mutate.mjs",
    "browser:prepare": "mkdir -p e2e-browser/pages/public/vendor && cp node_modules/@statewalker/webrun-http-browser/dist/sw-worker.js e2e-browser/pages/public/vendor/webrun-http-sw-worker.js",
    "browser:dev": "pnpm run browser:prepare && vite e2e-browser/pages --config e2e-browser/pages/vite.config.ts",
    "browser:build": "pnpm run browser:prepare && vite build e2e-browser/pages --config e2e-browser/pages/vite.config.ts",
    "e2e": "playwright test",
    "e2e:firefox": "PW_BROWSERS=firefox playwright test",
    "e2e:webkit": "PW_BROWSERS=webkit playwright test",
    "interop": "scripts/interop-env.sh vitest run e2e/ test/p09-celld-conformance.test.ts",
    "interop:browser": "scripts/interop-env.sh playwright test celld-bucket opfs-bucket",
    "e2e:npm-chromium": "PW_CHROMIUM=\"$(node scripts/npm-chromium.mjs)\" playwright test",
    "mutate:browser": "node scripts/mutate-browser.mjs",
    "mutate:check": "node scripts/mutate.mjs --check && node scripts/mutate-browser.mjs --check",
    "probes:browser": "PW_CHROMIUM=\"${PW_CHROMIUM:-$(node scripts/npm-chromium.mjs)}\" playwright test --config playwright.probes.config.ts --reporter=line",
    "probes:node": "node --no-warnings probes/sqlite-lock.probe.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@statewalker/webrun-files": "^0.10.0",
    "@statewalker/webrun-http-browser": "catalog:",
    "@statewalker/webrun-http-streams": "^0.2.2",
    "@statewalker/webrun-rpc": "^0.4.0",
    "@statewalker/webrun-site-builder": "catalog:",
    "@statewalker/webrun-site-host": "catalog:",
    "@statewalker/webrun-streams": "^0.2.0",
    "acorn": "^8.19.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "sqlite-vec": "^0.1.7",
    "util": "^0.12.5",
    "worker-timers": "^8.0.0",
    "@statewalker/webrun-files-mem": "^0.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@statewalker/webrun-files-browser": "^0.10.0",
    "@statewalker/webrun-http-browser": "^0.6.0",
    "@statewalker/webrun-modules": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "^0.28.0",
    "html-rewriter-wasm": "^0.4.1",
    "miniflare": "4.20260730.0",
    "sqlite-vec-wasm-demo": "0.1.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "^3.25.0"
  },
  "private": true
}
