{
  "name": "@statewalker/cellb",
  "version": "0.8.4",
  "description": "cellb: isomorphic Durable Objects runtime (celld/Cloudflare-compatible surface) for browsers and servers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git",
    "directory": "packages/cellb"
  },
  "homepage": "https://github.com/statewalker/cellb.dev/tree/main/packages/cellb#readme",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "cellb": "./bin/cellb.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./browser": "./src/browser.ts",
    "./tabs": "./src/tabs.ts",
    "./site": "./src/site.ts",
    "./bundle": "./src/bundle.ts",
    "./host-modules": "./src/project/host-modules.ts",
    "./isolate-worker": "./src/isolate/isolate-worker.ts"
  },
  "files": [
    "dist",
    "bin",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./tabs": {
        "types": "./dist/tabs.d.ts",
        "default": "./dist/tabs.js"
      },
      "./site": {
        "types": "./dist/site.d.ts",
        "default": "./dist/site.js"
      },
      "./bundle": {
        "types": "./dist/bundle.d.ts",
        "default": "./dist/bundle.js"
      },
      "./host-modules": {
        "types": "./dist/project/host-modules.d.ts",
        "default": "./dist/project/host-modules.js"
      },
      "./isolate-worker": {
        "types": "./dist/isolate/isolate-worker.d.ts",
        "default": "./dist/isolate/isolate-worker.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "vitest run",
    "bench": "node scripts/build.mjs && node --expose-gc bench/node-bench.mjs",
    "bench:browser": "PW_CHROMIUM=\"${PW_CHROMIUM:-$(node scripts/npm-chromium.mjs)}\" playwright test --config playwright.probes.config.ts --reporter=line bench",
    "test:unit": "vitest run test/",
    "test:e2e": "vitest run e2e/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e-browser/pages/tsconfig.json",
    "mutate": "node scripts/mutate.mjs",
    "browser:prepare": "mkdir -p e2e-browser/pages/public/vendor && cp node_modules/@statewalker/webrun-http-browser/dist/sw-worker.js e2e-browser/pages/public/vendor/webrun-http-sw-worker.js",
    "browser:dev": "pnpm run browser:prepare && vite e2e-browser/pages --config e2e-browser/pages/vite.config.ts",
    "browser:build": "pnpm run browser:prepare && vite build e2e-browser/pages --config e2e-browser/pages/vite.config.ts",
    "e2e": "playwright test",
    "e2e:firefox": "PW_BROWSERS=firefox playwright test",
    "e2e:webkit": "PW_BROWSERS=webkit playwright test",
    "interop": "scripts/interop-env.sh vitest run e2e/ test/p09-celld-conformance.test.ts",
    "interop:browser": "scripts/interop-env.sh playwright test celld-bucket opfs-bucket",
    "e2e:npm-chromium": "PW_CHROMIUM=\"$(node scripts/npm-chromium.mjs)\" playwright test",
    "mutate:browser": "node scripts/mutate-browser.mjs",
    "mutate:check": "node scripts/mutate.mjs --check && node scripts/mutate-browser.mjs --check",
    "probes:browser": "PW_CHROMIUM=\"${PW_CHROMIUM:-$(node scripts/npm-chromium.mjs)}\" playwright test --config playwright.probes.config.ts --reporter=line",
    "probes:node": "node --no-warnings probes/sqlite-lock.probe.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@statewalker/webrun-files": "^0.10.3",
    "@statewalker/webrun-files-browser": "^0.10.2",
    "@statewalker/webrun-files-mem": "^0.10.3",
    "@statewalker/webrun-files-node": "^0.10.3",
    "@statewalker/webrun-http-browser": "catalog:",
    "@statewalker/webrun-http-streams": "^0.4.2",
    "@statewalker/webrun-rpc": "^0.10.2",
    "@statewalker/webrun-streams": "^0.2.3",
    "acorn": "^8.19.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "sqlite-vec": "^0.1.9",
    "util": "^0.12.5",
    "worker-timers": "^8.0.34",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@statewalker/webrun-bundler": "^0.1.1",
    "@statewalker/webrun-modules": "catalog:",
    "@statewalker/webrun-site-builder": "catalog:",
    "@statewalker/webrun-site-host": "catalog:",
    "esbuild": ">=0.25"
  },
  "peerDependenciesMeta": {
    "@statewalker/webrun-bundler": {
      "optional": true
    },
    "@statewalker/webrun-modules": {
      "optional": true
    },
    "@statewalker/webrun-site-builder": {
      "optional": true
    },
    "@statewalker/webrun-site-host": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "@statewalker/webrun-bundler": "^0.1.1",
    "@statewalker/webrun-modules": "catalog:",
    "@statewalker/webrun-site-builder": "catalog:",
    "@statewalker/webrun-site-host": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "0.28.2",
    "html-rewriter-wasm": "^0.4.1",
    "miniflare": "4.20260730.0",
    "partyserver": "0.5.10",
    "partywhen": "0.1.5",
    "sqlite-vec-wasm-demo": "0.1.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "^3.25.0"
  }
}
