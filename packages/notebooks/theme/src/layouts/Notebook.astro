---
// The page frame: site title, navigation between notebooks, the notebook, its table of contents.
const { page, site } = Astro.props;
const toc = page.outline.filter((o) => o.depth >= 2 && o.depth <= 3);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} · {site.title}</title>
    <link rel="stylesheet" href={page.stylesUrl} />
  </head>
  <body>
    <header class="site-header"><a href={site.home}>{site.title}</a></header>
    <div class="frame">
      <nav class="site-nav" aria-label="Notebooks">
        <ul>
          {site.pages.map((p) => (
            <li><a href={p.path} aria-current={p.id === page.id ? "page" : undefined}>{p.title}</a></li>
          ))}
        </ul>
      </nav>
      <main class="notebook"><slot /></main>
      {toc.length > 0 && (
        <aside class="toc" aria-label="On this page">
          <ul>{toc.map((o) => <li class={`depth-${o.depth}`}><a href={`#${o.slug}`}>{o.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </body>
</html>
<style is:global>
  :root { --fg: #1b1b1f; --muted: #6b6b76; --line: #e4e4e8; --accent: #4f46e5; --bg: #fff; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e8e8ee; --muted: #9a9aa6; --line: #2c2c34; --accent: #a5b4fc; --bg: #121216; }
  }
  body { margin: 0; color: var(--fg); background: var(--bg); font: 16px/1.6 system-ui, sans-serif; }
  .site-header { padding: 12px 24px; border-bottom: 1px solid var(--line); font-weight: 600; }
  .site-header a { color: inherit; text-decoration: none; }
  .frame { display: grid; grid-template-columns: 200px minmax(0, 1fr) 200px; gap: 32px; padding: 24px; }
  .site-nav ul, .toc ul { list-style: none; margin: 0; padding: 0; }
  .site-nav a, .toc a { display: block; padding: 4px 0; color: var(--muted); text-decoration: none; }
  .site-nav a[aria-current="page"] { color: var(--accent); font-weight: 600; }
  .toc .depth-3 { padding-left: 12px; }
  .notebook { max-width: 760px; }
  .cell { margin: 12px 0; }
  .cell-error { color: #b91c1c; white-space: pre-wrap; }
  @media (max-width: 900px) {
    .frame { grid-template-columns: minmax(0, 1fr); padding: 16px; }
    .toc { display: none; }
  }
</style>
