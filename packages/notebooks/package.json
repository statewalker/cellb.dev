{
  "name": "@statewalker/cellb-notebooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git",
    "directory": "packages/notebooks"
  },
  "description": "Markdown and Observable Notebook Kit notebooks compiled to pages in a Durable Object (notebook-build), their npm imports served by the site's module server.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/cellb-platform-core": "workspace:*",
    "@statewalker/cellb-esm-cdn": "workspace:*",
    "@statewalker/notebook-build": "catalog:",
    "@statewalker/notebook-site": "catalog:",
    "@statewalker/webrun-builder": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-modules": "catalog:",
    "linkedom": "catalog:",
    "urlpattern-polyfill": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
