{
  "name": "@statewalker/cellb-notebooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git",
    "directory": "packages/notebooks"
  },
  "description": "Markdown and Observable Notebook Kit notebooks compiled to pages in a Durable Object (notebook-build), their npm imports served by the site's module server, and rendered by an Astro theme from page models.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@observablehq/notebook-kit": "^2.11.0",
    "@portabletext/markdown": "^2.9.4",
    "@portabletext/to-html": "^6.0.0",
    "@statewalker/cellb-bundler": "workspace:*",
    "@statewalker/cellb-esm-cdn": "workspace:*",
    "@statewalker/cellb-platform-core": "workspace:*",
    "@statewalker/notebook-build": "catalog:",
    "@statewalker/notebook-db": "^0.1.1",
    "@statewalker/notebook-site": "catalog:",
    "@statewalker/webrun-builder": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-modules": "catalog:",
    "linkedom": "catalog:",
    "markdown-it": "^15.0.3",
    "urlpattern-polyfill": "catalog:"
  },
  "devDependencies": {
    "@portabletext/types": "^4.0.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
