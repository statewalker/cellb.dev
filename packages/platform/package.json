{
  "name": "@statewalker/cellb-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/cellb.dev.git",
    "directory": "packages/platform"
  },
  "description": "The platform: the ESM CDN, user code as ESM, the bundler (Astro builds included) and notebooks composed into one Worker, built for Wrangler, celld and cellb (Node and browsers), with its end-to-end checks.",
  "exports": {
    ".": "./src/platform.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:apps": "node scripts/build.mjs src/entries/cdn.ts deploy/cdn.jsonc cdn && node scripts/build.mjs src/entries/bundler.ts deploy/bundler.jsonc bundler",
    "build:browser": "tsx scripts/build-browser.mjs",
    "e2e": "tsx scripts/e2e.ts all",
    "e2e:browser": "tsx scripts/e2e-browser.ts"
  },
  "dependencies": {
    "@statewalker/cellb-platform-core": "workspace:*",
    "@statewalker/cellb-esm-cdn": "workspace:*",
    "@statewalker/cellb-bundler": "workspace:*",
    "@statewalker/cellb-astro-builder": "workspace:*",
    "@statewalker/cellb-notebooks": "workspace:*",
    "cjs-module-lexer": "catalog:",
    "esbuild-wasm": "catalog:",
    "lightningcss-wasm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@statewalker/cellb": "workspace:*",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "wrangler": "catalog:"
  }
}
