{
  "name": "@statewalker/cellb-sandbox-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The hub of a CellB sandbox mesh (HTTPeers): a local Node app that holds the mesh's identity, mints invitations, and reserves on a public relay; plus a bridge that gives a desktop agent a published sandbox's MCP endpoint.",
  "scripts": {
    "start": "tsx src/main.ts start",
    "invite": "tsx src/main.ts invite",
    "members": "tsx src/main.ts members",
    "bridge": "tsx src/bridge.ts",
    "test": "tsx test/mesh.test.ts",
    "build": "node build.mjs",
    "revoke": "tsx src/main.ts revoke"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/interface": "^3.4.0",
    "@libp2p/tcp": "^11.0.28",
    "@libp2p/webrtc": "^7.0.2",
    "@libp2p/websockets": "^10.1.21",
    "@statewalker/cellb": "workspace:*",
    "@statewalker/httpeers-access": "^0.1.4",
    "@statewalker/httpeers-core": "^0.1.3",
    "@statewalker/httpeers-hub": "^0.1.4",
    "@statewalker/httpeers-libp2p": "^0.3.2",
    "@statewalker/httpeers-member": "^0.3.2",
    "libp2p": "^3.5.1",
    "node-datachannel": "^0.33.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.20.6",
    "esbuild": "catalog:"
  }
}
